<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.db_project1.DoctorHomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <!-- Header Section with consistent date display -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox>
                    <Label text="Dashboard" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label text="Today's Date"/>
                    <Label fx:id="dateLabel" text="2025-05-14" style="-fx-font-weight: bold;"/>
                </HBox>
            </children>
        </HBox>

        <!-- Welcome Banner -->
        <AnchorPane style="-fx-background-color: #d4ebf2; -fx-background-radius: 10px;" prefHeight="150.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <VBox spacing="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" maxWidth="600.0">
                    <Label text="Welcome!" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Label fx:id="welcomeMessage" text="Thanks for joining with us. We are always trying to get you a complete service. You can view your daily schedule, reach patients' appointments at home!" wrapText="true"/>

                    <HBox spacing="10.0" style="-fx-padding: 10 0 0 0;">
                        <Button fx:id="viewAppointmentsBtn" text="View My Appointments" onAction="#viewAppointmentsBtnOnAction"
                                style="-fx-background-color: #2d7ae5; -fx-text-fill: white;"
                                prefHeight="40.0" prefWidth="200.0"/>
                    </HBox>
                </VBox>
            </children>
        </AnchorPane>

        <!-- Status Cards -->
        <HBox spacing="15.0">
            <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;"
                  prefWidth="180.0" prefHeight="100.0">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                </padding>
                <children>
                    <Label fx:id="doctorsCountLabel" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d7ae5;"/>
                    <Label text="All Doctors" style="-fx-font-size: 14px;"/>
                </children>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;"
                  prefWidth="180.0" prefHeight="100.0">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                </padding>
                <children>
                    <Label fx:id="patientsCountLabel" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d7ae5;"/>
                    <Label text="All Patients" style="-fx-font-size: 14px;"/>
                </children>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;"
                  prefWidth="180.0" prefHeight="100.0">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                </padding>
                <children>
                    <Label fx:id="newBookingsLabel" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d7ae5;"/>
                    <Label text="New Bookings" style="-fx-font-size: 14px;"/>
                </children>
            </VBox>

            <VBox style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;"
                  prefWidth="180.0" prefHeight="100.0">
                <padding>
                    <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
                </padding>
                <children>
                    <Label fx:id="todayAppointmentsLabel" text="0"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d7ae5;"/>
                    <Label text="Today's Appointments" style="-fx-font-size: 14px;"/>
                </children>
            </VBox>
        </HBox>

        <!-- Upcoming Appointments Section -->
        <Label text="Your Upcoming Appointments" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <TableView fx:id="upcomingAppointmentsTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="appointIdColumn" prefWidth="80.0" text="Appt. ID"/>
                <TableColumn fx:id="patientNameColumn" prefWidth="180.0" text="Patient Name"/>
                <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date"/>
                <TableColumn fx:id="timeColumn" prefWidth="100.0" text="Time"/>
                <TableColumn fx:id="reasonColumn" prefWidth="180.0" text="Reason"/>
                <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status"/>
            </columns>
        </TableView>
    </children>
</VBox>