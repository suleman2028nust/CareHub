<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.db_project1.BookAppointmentController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <!-- Header with date -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Book New Appointment" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                        <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                            <Label text="Today's Date" />
                            <Label fx:id="dateLabel" text="2025-05-09" style="-fx-font-weight: bold;" />
                        </HBox>
                    </children>
                </HBox>

                <Separator />

                <!-- Main content in a scrollable area -->
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox spacing="20.0">
                            <!-- Step 1: Select Appointment Type -->
                            <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 5px; -fx-padding: 15px;">
                                <Label text="Step 1: Select Appointment Type" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <ComboBox fx:id="appointmentTypeCombo" prefWidth="300.0" promptText="Select Appointment Type" />
                            </VBox>

                            <!-- Step 2: Find a Doctor -->
                            <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 5px; -fx-padding: 15px;">
                                <Label text="Step 2: Find a Doctor" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <HBox spacing="10.0">
                                    <ComboBox fx:id="specializationCombo" prefWidth="300.0" promptText="Select Specialization" />
                                    <Button fx:id="searchDoctorsBtn" text="Search" onAction="#searchDoctors"
                                            style="-fx-background-color: #2d7ae5; -fx-text-fill: white;" />
                                </HBox>

                                <Label text="Available Doctors:" />
                                <ListView fx:id="doctorsListView" prefHeight="150.0" />

                                <VBox fx:id="doctorDetailsPane" spacing="5.0" visible="false" style="-fx-background-color: #e8f4f8; -fx-padding: 10px; -fx-background-radius: 5px;">
                                    <Label text="Doctor Details" style="-fx-font-weight: bold;" />
                                    <HBox spacing="5.0">
                                        <Label text="Name:" />
                                        <Label fx:id="doctorNameLabel" text="Dr. Name" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Specialization:" />
                                        <Label fx:id="doctorSpecializationLabel" text="Specialization" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Experience:" />
                                        <Label fx:id="doctorExperienceLabel" text="0 years" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Languages:" />
                                        <Label fx:id="doctorLanguagesLabel" text="Languages" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Schedule:" />
                                        <Label fx:id="doctorScheduleLabel" text="Schedule" />
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- Step 3: Select Date and Time -->
                            <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 5px; -fx-padding: 15px;">
                                <Label text="Step 3: Select Date and Time" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <HBox spacing="20.0">
                                    <VBox spacing="5.0">
                                        <Label text="Date" />
                                        <DatePicker fx:id="appointmentDatePicker" />
                                    </VBox>
                                    <VBox spacing="5.0">
                                        <Label text="Time" />
                                        <ComboBox fx:id="appointmentTimeCombo" prefWidth="150.0" promptText="Select Time" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <!-- Step 4: Appointment Summary -->
                            <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 5px; -fx-padding: 15px;">
                                <Label text="Step 4: Appointment Summary" style="-fx-font-weight: bold; -fx-font-size: 16px;" />
                                <VBox spacing="5.0">
                                    <HBox spacing="5.0">
                                        <Label text="Doctor:" />
                                        <Label fx:id="summaryDoctorLabel" text="Not selected" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Specialization:" />
                                        <Label fx:id="summarySpecializationLabel" text="Not selected" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Date:" />
                                        <Label fx:id="summaryDateLabel" text="Not selected" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Time:" />
                                        <Label fx:id="summaryTimeLabel" text="Not selected" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Type:" />
                                        <Label fx:id="summaryTypeLabel" text="Not selected" />
                                    </HBox>
                                    <HBox spacing="5.0">
                                        <Label text="Consultation Fee:" />
                                        <Label fx:id="summaryFeeLabel" text="0.00" />
                                    </HBox>
                                </VBox>
                            </VBox>

                            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                                <Button fx:id="cancelBtn" text="Cancel" onAction="#cancelAppointment"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
                                <Button fx:id="bookBtn" text="Book Appointment" onAction="#bookAppointment"
                                        style="-fx-background-color: #2ecc71; -fx-text-fill: white;" />
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>