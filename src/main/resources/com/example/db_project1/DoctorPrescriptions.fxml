<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.db_project1.DoctorPrescriptionsController">
    <children>
        <VBox prefHeight="650.0" prefWidth="950.0" spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="950.0" spacing="10.0">
                    <children>
                        <Button fx:id="backBtn" mnemonicParsing="false" onAction="#backBtnOnAction" style="-fx-background-color: #e6f2ff;" text="← Back">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Label text="Patient Prescriptions">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="prescriptionCountLabel" text="(0)" textFill="#646464">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="10.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="950.0" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" prefHeight="35.0" prefWidth="300.0" promptText="Search Patient name">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>
                        <DatePicker fx:id="datePicker" prefHeight="35.0" prefWidth="180.0" promptText="Filter by Date" />
                        <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#searchBtnOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #2d7ae5; -fx-text-fill: white;" text="Search">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="newPrescriptionBtn" mnemonicParsing="false" onAction="#newPrescriptionBtnOnAction" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: #2d7ae5; -fx-text-fill: white;" text="New Prescription">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#refreshBtnOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #f0f0f0;" text="Refresh">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                </HBox>

                <!-- Previous Prescriptions Table -->
                <TableView fx:id="prescriptionsTable" minHeight="-Infinity" prefHeight="193.0" prefWidth="930.0">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="patientNameColumn" prefWidth="150.0" text="Patient Name" />
                        <TableColumn fx:id="dateIssuedColumn" prefWidth="120.0" text="Date Issued" />
                        <TableColumn fx:id="diagnosisColumn" prefWidth="200.0" text="Diagnosis" />
                        <TableColumn fx:id="medicationsColumn" prefWidth="250.0" text="Medications" />
                        <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
                    </columns>
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </VBox.margin>
                </TableView>

                <Separator />

                <!-- Prescription Creation Form -->
                <VBox fx:id="prescriptionFormContainer" prefHeight="300.0" prefWidth="930.0" spacing="10.0" visible="false">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Create New Prescription">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>

                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="350.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="250.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Patient:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="patientComboBox" prefHeight="35.0" prefWidth="350.0" promptText="Select Patient" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Date:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <DatePicker fx:id="prescriptionDate" prefHeight="35.0" prefWidth="250.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <Label text="Diagnosis:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="diagnosisField" prefHeight="35.0" prefWidth="350.0" promptText="Enter diagnosis" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Medication:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="medicationComboBox" prefHeight="35.0" prefWidth="350.0" promptText="Select Medication" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Button fx:id="addMedicationBtn" mnemonicParsing="false" onAction="#addMedicationBtnOnAction" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add Medication" GridPane.columnIndex="2" GridPane.rowIndex="2">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </GridPane>

                        <HBox prefHeight="150.0" spacing="10.0">
                            <children>
                                <VBox prefHeight="150.0" prefWidth="450.0" spacing="5.0">
                                    <children>
                                        <Label text="Selected Medications:">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <ListView fx:id="selectedMedicationsListView" prefHeight="120.0" prefWidth="450.0" />
                                    </children>
                                </VBox>

                                <VBox prefHeight="150.0" prefWidth="450.0" spacing="5.0">
                                    <children>
                                        <Label text="Remarks:">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextArea fx:id="remarksTextArea" prefHeight="120.0" prefWidth="450.0" promptText="Enter any additional remarks" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#cancelBtnOnAction" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #f0f0f0;" text="Cancel">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Button>
                                <Button fx:id="savePrescriptionBtn" mnemonicParsing="false" onAction="#savePrescriptionBtnOnAction" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2d7ae5; -fx-text-fill: white;" text="Save Prescription">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                            <padding>
                                <Insets right="10.0" />
                            </padding>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                    </padding>
                </VBox>

                <!-- Add Medication Dialog -->
                <VBox fx:id="addMedicationDialog" prefHeight="200.0" prefWidth="930.0" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #f9f9f9;" visible="false">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Add Medication Details">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Label>

                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="350.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="250.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Dosage:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="dosageField" prefHeight="35.0" prefWidth="350.0" promptText="e.g., 500mg" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Frequency:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="frequencyField" prefHeight="35.0" prefWidth="250.0" promptText="e.g., 3 times daily" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <Label text="Duration:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="durationField" prefHeight="35.0" prefWidth="350.0" promptText="e.g., 7 days" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="cancelMedicationBtn" mnemonicParsing="false" onAction="#cancelMedicationBtnOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #f0f0f0;" text="Cancel">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Button>
                                <Button fx:id="confirmMedicationBtn" mnemonicParsing="false" onAction="#confirmMedicationBtnOnAction" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Add to Prescription">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                            <padding>
                                <Insets right="10.0" />
                            </padding>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>

                <!-- View Prescription Details Dialog -->
                <VBox fx:id="viewPrescriptionDialog" prefHeight="280.0" prefWidth="930.0" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-background-color: #f9f9f9;" visible="false">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="Prescription Details">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <Label fx:id="prescriptionIdLabel" text="(ID: 0)" textFill="#646464">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>

                        <GridPane hgap="15.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="350.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="100.0" prefWidth="150.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="200.0" prefWidth="250.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Label text="Patient:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="patientNameLabel" text="Patient Name" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>

                                <Label text="Date Issued:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="dateIssuedLabel" text="Date" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>

                                <Label text="Diagnosis:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="diagnosisLabel" text="Diagnosis" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </GridPane>

                        <HBox prefHeight="150.0" spacing="10.0">
                            <children>
                                <VBox prefHeight="150.0" prefWidth="450.0" spacing="5.0">
                                    <children>
                                        <Label text="Medications:">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TableView fx:id="medicationsTableView" prefHeight="120.0" prefWidth="450.0">
                                            <columns>
                                                <TableColumn fx:id="medNameColumn" prefWidth="120.0" text="Name" />
                                                <TableColumn fx:id="medDosageColumn" prefWidth="100.0" text="Dosage" />
                                                <TableColumn fx:id="medFrequencyColumn" prefWidth="120.0" text="Frequency" />
                                                <TableColumn fx:id="medDurationColumn" prefWidth="110.0" text="Duration" />
                                            </columns>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox prefHeight="150.0" prefWidth="450.0" spacing="5.0">
                                    <children>
                                        <Label text="Remarks:">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextArea fx:id="viewRemarksTextArea" editable="false" prefHeight="120.0" prefWidth="450.0" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button fx:id="printBtn" mnemonicParsing="false" onAction="#printBtnOnAction" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Print">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Button>
                                <Button fx:id="closeDetailsBtn" mnemonicParsing="false" onAction="#closeDetailsBtnOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #f0f0f0;" text="Close">
                                    <font>
                                        <Font size="14.0" />
                                    </font>
                                </Button>
                            </children>
                            <padding>
                                <Insets right="10.0" />
                            </padding>
                        </HBox>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
