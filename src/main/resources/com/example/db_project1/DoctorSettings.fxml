<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <!-- Header Section with title -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox>
                    <Label text="Settings" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                </VBox>
            </children>
        </HBox>
        <Separator/>

        <!-- Account Security Section -->
        <Label text="Account Security" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <AnchorPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <VBox spacing="15.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <GridPane hgap="15.0" vgap="15.0">
                        <Label text="Current Password:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <PasswordField fx:id="currentPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250.0" />

                        <Label text="New Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <PasswordField fx:id="newPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="250.0" />

                        <Label text="Confirm New Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <PasswordField fx:id="confirmPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250.0" />

                        <Button fx:id="changePasswordBtn" text="Change Password"
                                style="-fx-background-color: #2d7ae5; -fx-text-fill: white;"
                                GridPane.columnIndex="1" GridPane.rowIndex="3"
                                />
                    </GridPane>
                </VBox>
            </children>
        </AnchorPane>

        <!-- Application Preferences Section -->
        <Label text="Application Preferences" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <AnchorPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <VBox spacing="15.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <GridPane hgap="15.0" vgap="15.0">
                        <Label text="Theme:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ComboBox fx:id="themeComboBox" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="250.0" />

                        <Label text="Notification Sounds:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ToggleButton fx:id="notificationSoundToggle" text="On"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"
                                       />

                        <Label text="Language:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <ComboBox fx:id="languageComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="250.0" />

                        <Button fx:id="savePreferencesBtn" text="Save Preferences"
                                style="-fx-background-color: #2d7ae5; -fx-text-fill: white;"
                                GridPane.columnIndex="1" GridPane.rowIndex="3"
                                />
                    </GridPane>
                </VBox>
            </children>
        </AnchorPane>

        <!-- Notification Settings Section -->
        <Label text="Notification Settings" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <AnchorPane style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-radius: 5px;">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
            </padding>
            <children>
                <VBox spacing="15.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <GridPane hgap="15.0" vgap="15.0">
                        <Label text="Email Notifications:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <ToggleButton fx:id="emailNotificationToggle" text="On"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       />

                        <Label text="SMS Notifications:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ToggleButton fx:id="smsNotificationToggle" text="On"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"
                                      />

                        <Label text="Appointment Reminders:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <ToggleButton fx:id="appointmentReminderToggle" text="On"
                                      GridPane.columnIndex="1" GridPane.rowIndex="2"
                                    />

                        <Button fx:id="saveNotificationBtn" text="Save Notification Settings"
                                style="-fx-background-color: #2d7ae5; -fx-text-fill: white;"
                                GridPane.columnIndex="1" GridPane.rowIndex="3"
                                 />
                    </GridPane>
                </VBox>
            </children>
        </AnchorPane>

        <!-- Status Messages -->
        <Label fx:id="statusLabel" style="-fx-text-fill: #2d7ae5; -fx-font-weight: bold;" />
    </children>
</VBox>