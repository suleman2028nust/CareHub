<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.RowConstraints?>
<AnchorPane prefHeight="650.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.db_project1.DoctorEditFormController">
    <children>
        <VBox alignment="TOP_CENTER" layoutX="14.0" layoutY="14.0" prefHeight="600.0" prefWidth="572.0" spacing="10.0" AnchorPane.bottomAnchor="14.0" AnchorPane.leftAnchor="14.0" AnchorPane.rightAnchor="14.0" AnchorPane.topAnchor="14.0">
            <children>
                <Label text="Edit Doctor Information" textFill="#0d47a1">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <StackPane>
                            <children>
                                <ImageView fx:id="doctorImageView" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>
                        <Button fx:id="uploadImageButton" mnemonicParsing="false" onAction="#handleUploadImage" text="Change Image" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                    </VBox.margin>
                </HBox>

                <GridPane hgap="10.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="150.0" prefWidth="150.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>

                    <children>
                        <Label text="Doctor ID" />
                        <TextField fx:id="idField" disable="true" promptText="ID (Auto-generated)" GridPane.columnIndex="1" />

                        <Label text="First Name *" GridPane.rowIndex="1" />
                        <TextField fx:id="firstNameField" promptText="First Name" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Middle Name" GridPane.rowIndex="2" />
                        <TextField fx:id="middleNameField" promptText="Middle Name (Optional)" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Last Name *" GridPane.rowIndex="3" />
                        <TextField fx:id="lastNameField" promptText="Last Name" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Email *" GridPane.rowIndex="4" />
                        <TextField fx:id="emailField" promptText="Email Address" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <Label text="Contact Number *" GridPane.rowIndex="5" />
                        <TextField fx:id="phoneField" promptText="Phone Number" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <Label text="Gender" GridPane.rowIndex="6" />
                        <ComboBox fx:id="genderComboBox" prefWidth="150.0" promptText="Select Gender" GridPane.columnIndex="1" GridPane.rowIndex="6" />

                        <Label text="Date of Birth" GridPane.rowIndex="7" />
                        <DatePicker fx:id="dobPicker" prefWidth="200.0" promptText="Select Date" GridPane.columnIndex="1" GridPane.rowIndex="7" />

                        <Label text="Specialization *" GridPane.rowIndex="8" />
                        <ComboBox fx:id="specializationComboBox" editable="true" prefWidth="150.0" promptText="Select or Enter" GridPane.columnIndex="1" GridPane.rowIndex="8" />

                        <Label text="Experience (Years)" GridPane.rowIndex="9" />
                        <Spinner fx:id="experienceSpinner" editable="true" GridPane.columnIndex="1" GridPane.rowIndex="9" />
                    </children>
                </GridPane>

                <HBox spacing="10.0">
                    <children>
                        <Label text="Languages" />
                        <TextField fx:id="languageField" prefHeight="25.0" prefWidth="397.0" promptText="Languages (comma-separated)" />
                    </children>
                    <padding>
                        <Insets bottom="5.0" top="5.0" />
                    </padding>
                </HBox>

                <VBox spacing="5.0">
                    <children>
                        <Label text="Schedule" />
                        <TextArea fx:id="scheduleArea" prefHeight="80.0" prefWidth="200.0" promptText="Enter availability schedule" wrapText="true" />
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="updateButton" defaultButton="true" mnemonicParsing="false" onAction="#handleUpdate" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2196f3;" text="Update" textFill="WHITE" />
                        <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #e0e0e0;" text="Cancel" />
                    </children>
                    <padding>
                        <Insets bottom="15.0" top="15.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
