<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.db_project1.AllDoctorsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <!-- Header Section with consistent date display -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="All Doctors" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label text="Today's Date"/>
                    <Label fx:id="dateLabel" text="2025-05-09" style="-fx-font-weight: bold;"/>
                </HBox>
            </children>
        </HBox>

        <!-- Search Section -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <TextField fx:id="searchField" prefHeight="40.0" prefWidth="500.0"
                           promptText="Search by doctor name, specialization, or email"/>
                <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#handleSearchButton"
                        prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #2d7ae5; -fx-text-fill: white;" text="Search"/>
                <Button fx:id="clearBtn" mnemonicParsing="false" onAction="#handleClearButton"
                        prefHeight="40.0" prefWidth="100.0"
                        style="-fx-background-color: #e0e0e0;" text="Clear"/>
            </children>
        </HBox>

        <!-- Doctor count -->
        <HBox>
            <children>
                <Label text="Total Doctors: "/>
                <Label fx:id="doctorCountLabel" text="0"/>
            </children>
        </HBox>

        <!-- Doctors Table -->
        <TableView fx:id="doctorsTable" prefHeight="500.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="doctorIdCol" prefWidth="80.0" text="ID"/>
                <TableColumn fx:id="doctorNameCol" prefWidth="200.0" text="Doctor Name"/>
                <TableColumn fx:id="specializationCol" prefWidth="150.0" text="Specialization"/>
                <TableColumn fx:id="experienceCol" prefWidth="100.0" text="Experience"/>
                <TableColumn fx:id="languageCol" prefWidth="100.0" text="Language"/>
                <TableColumn fx:id="emailCol" prefWidth="150.0" text="Email"/>
                <TableColumn fx:id="actionsCol" prefWidth="150.0" text="Actions"/>
            </columns>
        </TableView>

        <!-- Pagination -->
        <Pagination fx:id="doctorsPagination" maxPageIndicatorCount="5" prefHeight="40.0"/>
    </children>
</VBox>