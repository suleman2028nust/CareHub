<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.db_project1.DoctorPatientsController">
    <children>
        <VBox prefHeight="650.0" prefWidth="950.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="75.0" prefWidth="950.0" spacing="10.0">
                    <children>
                        <Button fx:id="backBtn" mnemonicParsing="false" onAction="#backBtnOnAction" style="-fx-background-color: #e6f2ff;" text="← Back">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Label text="My Patients">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label fx:id="patientCountLabel" text="(0)" textFill="#646464">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                    </children>
                    <padding>
                        <Insets left="10.0" />
                    </padding>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="950.0" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" prefHeight="35.0" prefWidth="450.0" promptText="Search Patient name or Email">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </TextField>
                        <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#searchBtnOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #2d7ae5; -fx-text-fill: white;" text="Search">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <ComboBox fx:id="filterComboBox" prefHeight="35.0" prefWidth="200.0" promptText="Filter By" />
                        <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#refreshBtnOnAction" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #f0f0f0;" text="Refresh">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                </HBox>
                <TableView fx:id="patientsTable" prefHeight="500.0" prefWidth="930.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="75.0" text="ID" />
                        <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Name" />
                        <TableColumn fx:id="dobColumn" prefWidth="100.0" text="Date of Birth" />
                        <TableColumn fx:id="genderColumn" prefWidth="75.0" text="Gender" />
                        <TableColumn fx:id="bloodGroupColumn" prefWidth="75.0" text="Blood Group" />
                        <TableColumn fx:id="phoneColumn" prefWidth="125.0" text="Phone" />
                        <TableColumn fx:id="emailColumn" prefWidth="175.0" text="Email" />
                        <TableColumn fx:id="actionsColumn" prefWidth="150.0" text="Actions" />
                    </columns>
                    <VBox.margin>
                        <Insets left="10.0" right="10.0" />
                    </VBox.margin>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>