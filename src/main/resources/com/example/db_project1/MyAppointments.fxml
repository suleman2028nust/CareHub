<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.db_project1.MyAppointmentsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <!-- Header Section with consistent date display -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="My Appointments" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <HBox alignment="CENTER_RIGHT" spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label text="Today's Date"/>
                    <Label fx:id="dateLabel" text="2025-05-09" style="-fx-font-weight: bold;"/>
                </HBox>
            </children>
        </HBox>

        <!-- Filter Section -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <ComboBox fx:id="statusFilterCombo" prefHeight="35.0" prefWidth="200.0" promptText="Filter by Status">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All" />
                            <String fx:value="Scheduled" />
                            <String fx:value="Completed" />
                            <String fx:value="Cancelled" />
                            <String fx:value="No-Show" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <DatePicker fx:id="dateFilterPicker" prefHeight="35.0" prefWidth="200.0" promptText="Filter by Date"/>
                <Button fx:id="applyFilterBtn" mnemonicParsing="false" onAction="#handleApplyFilter" prefHeight="35.0"
                        prefWidth="100.0" style="-fx-background-color: #2d7ae5; -fx-text-fill: white;" text="Apply"/>
                <Button fx:id="clearFilterBtn" mnemonicParsing="false" onAction="#handleClearFilter" prefHeight="35.0"
                        prefWidth="100.0" style="-fx-background-color: #e0e0e0;" text="Clear"/>
                <Button fx:id="newAppointmentBtn" mnemonicParsing="false" onAction="#handleNewAppointment" prefHeight="35.0"
                        prefWidth="170.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="New Appointment" HBox.hgrow="ALWAYS"/>
            </children>
        </HBox>

        <!-- Tab pane for different appointment statuses -->
        <TabPane fx:id="appointmentsTabPane" prefHeight="500.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="All Appointments">
                    <content>
                        <TableView fx:id="allAppointmentsTable">
                            <columns>
                                <TableColumn fx:id="allApptIdCol" prefWidth="80.0" text="Appt. ID"/>
                                <TableColumn fx:id="allDoctorCol" prefWidth="150.0" text="Doctor"/>
                                <TableColumn fx:id="allSpecializationCol" prefWidth="120.0" text="Specialization"/>
                                <TableColumn fx:id="allDateCol" prefWidth="100.0" text="Date"/>
                                <TableColumn fx:id="allTimeCol" prefWidth="80.0" text="Time"/>
                                <TableColumn fx:id="allStatusCol" prefWidth="100.0" text="Status"/>
                                <TableColumn fx:id="allTypeCol" prefWidth="100.0" text="Type"/>
                                <TableColumn fx:id="allActionsCol" prefWidth="170.0" text="Actions"/>
                            </columns>
                        </TableView>
                    </content>
                </Tab>
                <Tab text="Upcoming">
                    <content>
                        <TableView fx:id="upcomingAppointmentsTable">
                            <columns>
                                <TableColumn fx:id="upApptIdCol" prefWidth="80.0" text="Appt. ID"/>
                                <TableColumn fx:id="upDoctorCol" prefWidth="150.0" text="Doctor"/>
                                <TableColumn fx:id="upSpecializationCol" prefWidth="120.0" text="Specialization"/>
                                <TableColumn fx:id="upDateCol" prefWidth="100.0" text="Date"/>
                                <TableColumn fx:id="upTimeCol" prefWidth="80.0" text="Time"/>
                                <TableColumn fx:id="upTypeCol" prefWidth="100.0" text="Type"/>
                                <TableColumn fx:id="upActionsCol" prefWidth="270.0" text="Actions"/>
                            </columns>
                        </TableView>
                    </content>
                </Tab>
                <Tab text="Completed">
                    <content>
                        <TableView fx:id="completedAppointmentsTable">
                            <columns>
                                <TableColumn fx:id="compApptIdCol" prefWidth="80.0" text="Appt. ID"/>
                                <TableColumn fx:id="compDoctorCol" prefWidth="150.0" text="Doctor"/>
                                <TableColumn fx:id="compSpecializationCol" prefWidth="120.0" text="Specialization"/>
                                <TableColumn fx:id="compDateCol" prefWidth="100.0" text="Date"/>
                                <TableColumn fx:id="compTimeCol" prefWidth="80.0" text="Time"/>
                                <TableColumn fx:id="compTypeCol" prefWidth="100.0" text="Type"/>
                                <TableColumn fx:id="compActionsCol" prefWidth="270.0" text="Actions"/>
                            </columns>
                        </TableView>
                    </content>
                </Tab>
                <Tab text="Cancelled">
                    <content>
                        <TableView fx:id="cancelledAppointmentsTable">
                            <columns>
                                <TableColumn fx:id="cancelApptIdCol" prefWidth="80.0" text="Appt. ID"/>
                                <TableColumn fx:id="cancelDoctorCol" prefWidth="150.0" text="Doctor"/>
                                <TableColumn fx:id="cancelSpecializationCol" prefWidth="120.0" text="Specialization"/>
                                <TableColumn fx:id="cancelDateCol" prefWidth="100.0" text="Date"/>
                                <TableColumn fx:id="cancelTimeCol" prefWidth="80.0" text="Time"/>
                                <TableColumn fx:id="cancelActionsCol" prefWidth="270.0" text="Actions"/>
                            </columns>
                        </TableView>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>