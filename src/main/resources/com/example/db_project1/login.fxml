<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600" prefWidth="800" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.db_project1.LoginController">
   <!-- Blue background fills the entire window -->

   <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="500.0" style="-fx-background-color: white;" StackPane.alignment="CENTER">
      <!-- Centered login box with white background and sharp edges -->

      <center>
         <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" BorderPane.alignment="CENTER">
            <children>
               <Label text="Welcome Back!" textAlignment="CENTER">
                  <font>
                     <Font name="System Bold" size="28.0" />
                  </font>
               </Label>
               <Label text="Login with your details to continue" textFill="#757575">
                  <font>
                     <Font size="14.0" />
                  </font>
               </Label>
               <VBox spacing="5.0">
                  <children>
                     <Label text="Email:">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                     <TextField fx:id="emailField" prefHeight="40.0" promptText="Email Address">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </TextField>
                  </children>
                  <VBox.margin>
                     <Insets top="20.0" />
                  </VBox.margin>
               </VBox>
               <VBox spacing="5.0">
                  <children>
                     <Label text="Password:">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                     <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Password">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </PasswordField>
                  </children>
               </VBox>
               <Button fx:id="loginButton" defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" style="-fx-background-color: #0d6efd;" text="Login" textFill="WHITE">
                  <font>
                     <Font name="System Bold" size="14.0" />
                  </font>
                  <VBox.margin>
                     <Insets top="20.0" />
                  </VBox.margin>
               </Button>
               <HBox alignment="CENTER" spacing="5.0">
                  <children>
                     <Label text="Don't have an account?" textFill="#757575">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                     <Hyperlink fx:id="signUpLink" onAction="#handleSignUp" text="Sign Up">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Hyperlink>
                  </children>
                  <VBox.margin>
                     <Insets top="10.0" />
                  </VBox.margin>
               </HBox>
            </children>
            <BorderPane.margin>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </BorderPane.margin>
         </VBox>
      </center>
   </BorderPane>
</StackPane>
